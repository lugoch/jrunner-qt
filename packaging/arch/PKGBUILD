# Maintainer: JRunner contributors
# Local source package: regenerate the tarball and refresh checksums with
#   tar czf jrunner-$pkgver.tar.gz -C <stage> jrunner-$pkgver && updpkgsums
pkgname=jrunner
pkgver=0.1.0
pkgrel=1
pkgdesc="Java/Kotlin service launcher with a Qt6 native-Wayland UI and MCP control for external agents"
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-wayland' 'hicolor-icon-theme')
makedepends=('cmake' 'qt6-base' 'qt6-wayland')
optdepends=(
  'jdk-openjdk: run Java/Kotlin services'
  'maven: build and run Maven projects'
  'gradle: build and run Gradle projects'
  'git: branch monitoring and switching'
)
source=("jrunner-$pkgver.tar.gz")
sha256sums=('b96d69b588b197e9ae083c43efa770b7d37ef2afe96a886904439dbad524a08e')

build() {
  cd "$srcdir/jrunner-$pkgver"
  cmake -B build -S . \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build -j"$(nproc)"
}

package() {
  cd "$srcdir/jrunner-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
